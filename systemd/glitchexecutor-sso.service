[Unit]
Description=Glitch Executor SSO Authentication Service
After=network.target

[Service]
Type=exec
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/glitchexecutor-sso
Environment=PATH=/opt/glitchexecutor-sso/venv/bin
# Secrets migrated to env file 2026-05-18 per section-5 of
# SERVER_CONSOLIDATION_CHECKLIST.md. The env file is mode 640
# root:ubuntu — readable by the service user, not world-readable.
EnvironmentFile=/etc/glitchexecutor-sso/glitchexecutor-sso.env
ExecStart=/opt/glitchexecutor-sso/venv/bin/gunicorn --bind 127.0.0.1:6000 --workers 4 --timeout 10 app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
